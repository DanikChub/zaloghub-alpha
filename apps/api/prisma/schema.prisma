  NOT_ASSESSED
  NOT_IDENTIFIED
  NEEDS_REVIEW
  IDENTIFIED
}

enum BorrowerVerificationDecision {
  PENDING
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
}

enum BorrowerCheckResultType {
  BOOLEAN
  CATEGORY
  MONEY
  DOCUMENT
  RECORD_LIST
}

enum BorrowerCheckExecutionMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum BorrowerCheckRunMode {
  MANUAL
  AUTOMATIC
}

enum BorrowerCheckItemStatus {
  NOT_STARTED
  MISSING_DATA
  QUEUED
  RUNNING
  COMPLETED
  ERROR
  UNAVAILABLE
  NOT_APPLICABLE
  AWAITING_REVIEW
  STALE
}

enum BorrowerCheckRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BorrowerFindingType {
  COURT_CASE
  ENFORCEMENT
  BANKRUPTCY
  LIST_MATCH
  OTHER
}

enum BorrowerIdentityMatch {
  CONFIRMED
  POSSIBLE
  REJECTED
  UNKNOWN
}

enum BorrowerEvidenceKind {
  PASSPORT
  SNILS
  CERTIFICATE
  EXTRACT
  SCREENSHOT
  PROVIDER_RESPONSE
  OTHER
}

enum BorrowerEvidenceAuthenticity {
  NOT_CHECKED
  CONFIRMED
  DOUBTFUL
  REJECTED
}

enum BorrowerOcrStatus {
  NOT_REQUIRED
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum BorrowerRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BorrowerRiskRemediability {
  REMEDIABLE
  NON_REMEDIABLE
  UNKNOWN
}

enum BorrowerRiskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

