model BorrowerCheckFinding {
  id                String                         @id @default(uuid())
  workspaceId       String                         @map("workspace_id")
  verificationId    String                         @map("verification_id")
  runId             String                         @map("run_id")
  findingType       BorrowerFindingType            @map("finding_type")
  externalId        String?                        @map("external_id")
  recordKey         String                         @map("record_key")
  referenceNumber   String?                        @map("reference_number")
  title             String
  categoryCode      String?                        @map("category_code")
  personRole        String?                        @map("person_role")
  recordStatus      String?                        @map("record_status")
  openedOn          DateTime?                      @map("opened_on") @db.Date
  closedOn          DateTime?                      @map("closed_on") @db.Date
  claimAmount       Decimal?                       @map("claim_amount") @db.Decimal(20, 2)
  outstandingAmount Decimal?                       @map("outstanding_amount") @db.Decimal(20, 2)
  currency          String?                        @db.Char(3)
  authorityName     String?                        @map("authority_name")
  sourceUrl         String?                        @map("source_url")
  identityMatch     BorrowerIdentityMatch          @default(UNKNOWN) @map("identity_match")
  matchBasis        Json                           @default("{}") @map("match_basis")
  matchComment      String?                        @map("match_comment")
  matchReviewedById String?                        @map("match_reviewed_by_id")
  matchReviewedAt   DateTime?                      @map("match_reviewed_at") @db.Timestamptz(3)
  details           Json                           @default("{}")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace         Workspace                      @relation("BorrowerCheckFinding_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  run               BorrowerCheckRun               @relation("BorrowerCheckFinding_run", fields: [runId, verificationId, workspaceId], references: [id, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  matchReviewedBy   User?                          @relation("BorrowerCheckFinding_matchReviewedBy", fields: [matchReviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  evidence          BorrowerVerificationEvidence[] @relation("BorrowerVerificationEvidence_finding")
  risks             BorrowerVerificationRisk[]     @relation("BorrowerVerificationRisk_finding")

  @@unique([id, workspaceId], map: "borrower_check_findings_scope_key")
  @@unique([id, runId, verificationId, workspaceId], map: "finding_run_scope_key")
  @@unique([runId, recordKey], map: "finding_record_key")
  @@index([workspaceId], map: "borrower_check_findings_workspace_idx")
  @@index([workspaceId, findingType, identityMatch], map: "finding_match_idx")
  @@map("borrower_check_findings")
}

model BorrowerVerificationEvidence {
  id                 String                       @id @default(uuid())
  workspaceId        String                       @map("workspace_id")
  verificationId     String                       @map("verification_id")
  itemId             String?                      @map("item_id")
  runId              String?                      @map("run_id")
  findingId          String?                      @map("finding_id")
  documentId         String?                      @map("document_id")
  kind               BorrowerEvidenceKind
  title              String
  sourceUrl          String?                      @map("source_url")
  issuedOn           DateTime?                    @map("issued_on") @db.Date
  capturedAt         DateTime?                    @map("captured_at") @db.Timestamptz(3)
  validUntil         DateTime?                    @map("valid_until") @db.Timestamptz(3)
  authenticityStatus BorrowerEvidenceAuthenticity @default(NOT_CHECKED) @map("authenticity_status")
  ocrStatus          BorrowerOcrStatus            @default(NOT_REQUIRED) @map("ocr_status")
  ocrEngineVersion   String?                      @map("ocr_engine_version")
  ocrResult          Json?                        @map("ocr_result")
  ocrError           String?                      @map("ocr_error")
  reviewComment      String?                      @map("review_comment")
  reviewedById       String?                      @map("reviewed_by_id")
  reviewedAt         DateTime?                    @map("reviewed_at") @db.Timestamptz(3)
  uploadedById       String                       @map("uploaded_by_id")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace          Workspace                    @relation("BorrowerVerificationEvidence_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  verification       BorrowerVerification         @relation("BorrowerVerificationEvidence_verification", fields: [verificationId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  item               BorrowerVerificationItem?    @relation("BorrowerVerificationEvidence_item", fields: [itemId, verificationId, workspaceId], references: [id, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  run                BorrowerCheckRun?            @relation("BorrowerVerificationEvidence_run", fields: [runId, itemId, verificationId, workspaceId], references: [id, itemId, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  finding            BorrowerCheckFinding?        @relation("BorrowerVerificationEvidence_finding", fields: [findingId, runId, verificationId, workspaceId], references: [id, runId, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  document           Document?                    @relation("BorrowerVerificationEvidence_document", fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy         User?                        @relation("BorrowerVerificationEvidence_reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploadedBy         User                         @relation("BorrowerVerificationEvidence_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolvedRisks      BorrowerVerificationRisk[]   @relation("BorrowerVerificationRisk_resolutionEvidence")

  @@unique([id, workspaceId], map: "borrower_verification_evidence_scope_key")
  @@unique([id, verificationId, workspaceId], map: "evidence_verification_scope_key")
  @@index([workspaceId], map: "borrower_verification_evidence_workspace_idx")
  @@index([verificationId, kind], map: "evidence_kind_idx")
  @@index([documentId, workspaceId], map: "evidence_document_idx")
  @@map("borrower_verification_evidence")
}

model BorrowerVerificationRisk {
  id                   String                        @id @default(uuid())
  workspaceId          String                        @map("workspace_id")
  verificationId       String                        @map("verification_id")
  itemId               String                        @map("item_id")
  runId                String                        @map("run_id")
  findingId            String?                       @map("finding_id")
  riskCode             String                        @map("risk_code")
  ruleVersion          String                        @map("rule_version")
  title                String
  description          String
  severity             BorrowerRiskSeverity
  remediability        BorrowerRiskRemediability     @default(UNKNOWN)
  status               BorrowerRiskStatus            @default(OPEN)
  requiredAction       String?                       @map("required_action")
  assignedToId         String?                       @map("assigned_to_id")
  dueAt                DateTime?                     @map("due_at") @db.Timestamptz(3)
  resolutionComment    String?                       @map("resolution_comment")
  resolutionEvidenceId String?                       @map("resolution_evidence_id")
  resolvedById         String?                       @map("resolved_by_id")
  resolvedAt           DateTime?                     @map("resolved_at") @db.Timestamptz(3)
  createdAt            DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace            Workspace                     @relation("BorrowerVerificationRisk_workspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  run                  BorrowerCheckRun              @relation("BorrowerVerificationRisk_run", fields: [runId, itemId, verificationId, workspaceId], references: [id, itemId, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  finding              BorrowerCheckFinding?         @relation("BorrowerVerificationRisk_finding", fields: [findingId, runId, verificationId, workspaceId], references: [id, runId, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  resolutionEvidence   BorrowerVerificationEvidence? @relation("BorrowerVerificationRisk_resolutionEvidence", fields: [resolutionEvidenceId, verificationId, workspaceId], references: [id, verificationId, workspaceId], onDelete: Restrict, onUpdate: NoAction)
  assignedTo           User?                         @relation("BorrowerVerificationRisk_assignedTo", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolvedBy           User?                         @relation("BorrowerVerificationRisk_resolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([id, workspaceId], map: "borrower_verification_risks_scope_key")
  @@index([workspaceId], map: "borrower_verification_risks_workspace_idx")
  @@index([workspaceId, status, severity], map: "risk_status_severity_idx")
  @@index([verificationId, status], map: "risk_verification_status_idx")
  @@map("borrower_verification_risks")
}
